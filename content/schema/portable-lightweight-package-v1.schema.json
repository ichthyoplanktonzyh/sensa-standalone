{
  "$id": "https://sensa.example/schema/portable-lightweight-package-v1.json",
  "title": "Sensa Portable Lightweight Package v1",
  "description": "Public package.json manifest for a .sensa archive. Raw media uses content-addressed archive entries; authoring workflow is out of scope.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "sensa-portable-lightweight-package-v1"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "packageId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "author": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "license": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "sources": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "packageId",
        "version",
        "title",
        "description",
        "createdAt",
        "author",
        "license"
      ],
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "properties": {
        "targetLanguage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 35
        },
        "supportLanguage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 35
        }
      },
      "required": [
        "targetLanguage",
        "supportLanguage"
      ],
      "additionalProperties": false
    },
    "sense": {
      "type": "object",
      "properties": {
        "senseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      },
      "required": [
        "senseId",
        "meaning"
      ],
      "additionalProperties": false
    },
    "targetExpression": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "expressionKind": {
          "type": "string",
          "enum": [
            "word",
            "phrase",
            "construction",
            "utterance",
            "sentence",
            "unspecified"
          ]
        },
        "spokenForm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "acceptedForms": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "required": [
        "text",
        "expressionKind"
      ],
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "experienceRecallCue": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 8000
            },
            "senseFocus": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "images": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "mediaId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                  },
                  "altText": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "mediaId",
                  "altText"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "senseFocus"
          ],
          "additionalProperties": false
        },
        "senseConfirmation": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "pronunciation": {
          "type": "object",
          "properties": {
            "surface": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "audioMediaId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "method": {
              "type": "string",
              "enum": [
                "recording",
                "tts"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "phoneticNotation": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            },
            "accentLabel": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "surface",
            "audioMediaId",
            "method",
            "source"
          ],
          "additionalProperties": false
        },
        "sceneBridge": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "sceneRealization": {
          "type": "object",
          "properties": {
            "example": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "translation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "targetStart": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "targetEnd": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "audioMediaId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            }
          },
          "required": [
            "example",
            "translation",
            "targetStart",
            "targetEnd"
          ],
          "additionalProperties": false
        },
        "optional": {
          "type": "object",
          "properties": {
            "recallSupport": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              }
            },
            "languageStructure": {
              "type": "object",
              "properties": {
                "expressionTypeLabel": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "partOfSpeech": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "usagePattern": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "contrastNote": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "expressionTypeLabel",
                "partOfSpeech"
              ],
              "additionalProperties": false
            },
            "usageGuidance": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "example": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "translation": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "audioMediaId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                  }
                },
                "required": [
                  "example"
                ],
                "additionalProperties": false
              }
            },
            "boundaryContrast": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "sourceUrl": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "text",
                "source",
                "sourceUrl"
              ],
              "additionalProperties": false
            },
            "wordFormation": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "sourceUrl": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "text",
                "source",
                "sourceUrl"
              ],
              "additionalProperties": false
            },
            "mnemonic": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                }
              },
              "required": [
                "text"
              ],
              "additionalProperties": false
            },
            "etymology": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "sourceUrl": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "text",
                "source",
                "sourceUrl"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "experienceRecallCue",
        "senseConfirmation",
        "pronunciation",
        "sceneBridge",
        "sceneRealization",
        "optional"
      ],
      "additionalProperties": false
    },
    "media": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "audio",
              "image"
            ]
          },
          "mimeType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "attribution": {
            "type": "object",
            "properties": {
              "creator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "license": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "mediaId",
          "kind",
          "mimeType",
          "sha256",
          "sizeBytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "metadata",
    "route",
    "sense",
    "targetExpression",
    "resources",
    "media"
  ],
  "additionalProperties": false
}
