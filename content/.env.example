# Credential-free content authoring template. Copy to content/.env locally.

# Acquisition Profile and learning-resource generation provider.
SENSA_ACQUISITION_LLM_PROTOCOL=<openai-responses|openai-chat|anthropic|command>
SENSA_ACQUISITION_LLM_MODEL=<model-name>
SENSA_ACQUISITION_LLM_BASE_URL=<optional-provider-base-url>
SENSA_ACQUISITION_LLM_ENDPOINT=<optional-provider-endpoint>
SENSA_ACQUISITION_LLM_API_KEY=<local-secret>
SENSA_ACQUISITION_LLM_COMMAND=<local-command-only>

# Independent whole-package semantic reviewer. It never inherits generation settings.
SENSA_REVIEW_LLM_PROTOCOL=<openai-responses|openai-chat|anthropic|command>
SENSA_REVIEW_LLM_MODEL=<review-model-name>
SENSA_REVIEW_LLM_BASE_URL=<optional-provider-base-url>
SENSA_REVIEW_LLM_ENDPOINT=<optional-provider-endpoint>
SENSA_REVIEW_LLM_API_KEY=<local-secret>
SENSA_REVIEW_LLM_COMMAND=<local-command-only>
