{
  "name": "sensa-standalone",
  "version": "0.1.0",
  "private": true,
  "description": "Sensa sense-first language learning service",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/contracts",
    "packages/learning-kernel",
    "packages/content-validator",
    "apps/browser-extension"
  ],
  "scripts": {
    "sensa:service-status-smoke": "node --import tsx scripts/sensaServiceStatusSmoke.mts",
    "sensa:acceptance": "node scripts/sensaAcceptance.mjs",
    "sensa:acceptance:check": "node scripts/sensaAcceptance.mjs check",
    "sensa:acceptance:smoke": "node scripts/sensaAcceptanceSmoke.mjs",
    "build": "npm run build -w @sensa/learning-kernel && npm run build -w @sensa/contracts && npm run build -w @sensa/content-validator && npm run build -w @sensa/api && npm run build -w @sensa/web && npm --prefix apps/web-next run build && npm run build -w @sensa/browser-extension",
    "typecheck": "tsc -b --pretty false && npm run typecheck -w @sensa/web && npm --prefix apps/web-next run typecheck && npm run typecheck -w @sensa/browser-extension",
    "lint": "npm run typecheck",
    "dev": "npm run dev -w @sensa/api",
    "start": "npm run start -w @sensa/api",
    "api:dev": "npm run dev -w @sensa/api",
    "api:start": "npm run start -w @sensa/api",
    "web:dev": "npm run dev -w @sensa/web",
    "web:build": "npm run build -w @sensa/web",
    "web:preview": "npm run preview -w @sensa/web",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "sensa:first-user-import": "tsx scripts/sensaFirstUser/import.ts",
    "sensa:restore-first-user-plan": "tsx scripts/sensaFirstUser/restorePlan.ts",
    "sensa:repair-first-user-sync": "tsx scripts/sensaFirstUser/repairSync.ts",
    "media:ingest": "node scripts/ingest-runtime-media.mjs",
    "content:compile": "python3 -m compileall -q content/pipeline content/tools",
    "content:help": "python3 content/tools/pipeline.py --help",
    "content:smoke": "python3 content/tools/smoke_pipeline.py",
    "content:smoke-concurrency": "python3 content/tools/smoke_pipeline_concurrency.py",
    "sensa:runtime-smoke": "tsx scripts/sensaRuntimeSmoke.ts",
    "sensa:policy-smoke": "tsx scripts/sensaSemanticPolicySmoke.ts",
    "sensa:completion-policy-smoke": "tsx scripts/sensaCompletionPolicySmoke.ts",
    "sensa:personal-world-contract-smoke": "tsx scripts/sensaPersonalSemanticWorldContractSmoke.ts",
    "sensa:golden-content-smoke": "tsx scripts/sensaGoldenContentSmoke.ts",
    "sensa:golden-content-draft-v2-smoke": "tsx scripts/sensaGoldenContentDraftV2Smoke.ts",
    "sensa:compile-learning-release": "tsx scripts/compileWebNextLearningRelease.ts",
    "sensa:runtime-learning-smoke": "tsx --tsconfig apps/web-next/tsconfig.json scripts/sensaWebNextLearningRuntimeSmoke.ts",
    "sensa:web-next-smoke": "npm --prefix apps/web-next run smoke",
    "sensa:extensibility-contract-smoke": "tsx scripts/sensaLearningExtensibilityContractSmoke.ts",
    "sensa:learning-content-contract-smoke": "tsx scripts/sensaLearningContentContractSmoke.ts",
    "sensa:content-agent-live-smoke": "node --env-file-if-exists=.env --import tsx scripts/sensaDeepSeekContentAgentLiveSmoke.ts",
    "sensa:deepseek-content-agent-adapter-smoke": "tsx scripts/sensaDeepSeekContentAgentAdapterSmoke.ts",
    "sensa:protocol-progression-smoke": "tsx scripts/sensaProtocolProgressionKernelSmoke.ts",
    "sensa:four-stage-preset-smoke": "npm --prefix apps/web-next run smoke:four-stage",
    "sensa:sync-protocol-smoke": "tsx scripts/sensaSyncProtocolSmoke.ts",
    "sensa:capability-smoke": "tsx scripts/sensaCapabilitySmoke.ts",
    "sensa:capability-db-smoke": "node --env-file-if-exists=apps/api/.env --import tsx scripts/sensaCapabilityDatabaseSmoke.ts",
    "sensa:web-ui-smoke": "tsx scripts/sensaWebUiSmoke.ts",
    "sensa:content-navigation-smoke": "tsx scripts/sensaContentNavigationSmoke.ts",
    "sensa:lightweight-runtime-smoke": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx scripts/sensaLightweightRuntimeSmoke.tsx",
    "sensa:runtime-checkpoint-smoke": "tsx scripts/sensaRuntimeCheckpointSmoke.ts",
    "sensa:assurance-runtime-smoke": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx scripts/sensaAssuranceRuntimeSmoke.tsx",
    "sensa:consumer-account-smoke": "node --import tsx scripts/sensaConsumerAccountSmoke.mts",
    "sensa:web-local-journey-smoke": "node --import tsx scripts/sensaWebLocalJourneySmoke.mts",
    "sensa:email-link-browser-smoke": "node --import tsx scripts/sensaEmailLinkBrowserSmoke.mts",
    "sensa:web-account-isolation-smoke": "node --import tsx scripts/sensaWebAccountIsolationSmoke.mts",
    "sensa:consumer-browser-smoke": "node --import tsx scripts/sensaConsumerBrowserSmoke.mts",
    "sensa:edge-check": "deno check --config supabase/functions/sensa-api/deno.json supabase/functions/sensa-api/index.ts",
    "sensa:consumer-checkin-smoke": "node --import tsx scripts/sensaConsumerAccountSmoke.mts --targets --initial --retention --checkin",
    "sensa:consumer-retention-smoke": "node --import tsx scripts/sensaConsumerAccountSmoke.mts --targets --initial --retention",
    "sensa:consumer-initial-smoke": "node --import tsx scripts/sensaConsumerAccountSmoke.mts --targets --initial",
    "sensa:consumer-target-smoke": "node --import tsx scripts/sensaConsumerAccountSmoke.mts --targets",
    "sensa:consumer-intake-smoke": "node --import tsx scripts/sensaConsumerAccountSmoke.mts --intake",
    "sensa:extension-browser-smoke": "node --import tsx scripts/sensaExtensionBrowserSmoke.mts",
    "sensa:pronunciation-browser-smoke": "node --import tsx scripts/sensaPronunciationBrowserSmoke.mts",
    "sensa:content-recovery-browser-smoke": "node --import tsx scripts/sensaContentRecoveryBrowserSmoke.mts",
    "sensa:extension-native-fixture": "node --import tsx scripts/sensaExtensionNativeFixture.mts",
    "sensa:consumer-settlement-smoke": "node --import tsx scripts/sensaConsumerSettlementSmoke.mts",
    "sensa:native-core-smoke": "node --import tsx scripts/sensaNativeCoreParity.mts",
    "sensa:personal-learning-smoke": "node --import tsx scripts/sensaPersonalLearningSmoke.mts",
    "sensa:personal-intake-browser-smoke": "node --import tsx scripts/sensaOfflineColdStartSmoke.mts --personal-intake",
    "sensa:package-learning-smoke": "node --import tsx scripts/sensaPackageLearningSmoke.mts",
    "sensa:offline-cold-start-smoke": "node --import tsx scripts/sensaOfflineColdStartSmoke.mts",
    "sensa:offline-shell-smoke": "node --import tsx scripts/sensaOfflineShellSmoke.mts",
    "sensa:web-intake-smoke": "node --import tsx scripts/sensaWebIntakeSmoke.mts",
    "sensa:account-service-db-smoke": "node --import tsx scripts/sensaAccountServiceDatabaseSmoke.mts",
    "sensa:library-backup-smoke": "node --import tsx scripts/sensaPersonalLearningSmoke.mts --backup",
    "sensa:library-backup-browser-smoke": "node --import tsx scripts/sensaOfflineColdStartSmoke.mts --backup",
    "sensa:local-i18n-smoke": "node --import tsx scripts/sensaLocalI18nSmoke.mts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.20.0",
    "typescript": "^7.0.0",
    "@babel/parser": "7.29.8"
  }
}
