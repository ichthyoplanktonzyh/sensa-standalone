{
  "name": "sensa-standalone",
  "version": "0.1.0",
  "private": true,
  "description": "Sensa sense-first language learning service",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/contracts",
    "packages/learning-kernel",
    "packages/content-validator",
    "apps/browser-extension",
    "packages/model-runtime",
    "packages/mcp-server"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run build && npm test",
    "build": "npm run build -w @sensa/learning-kernel && npm run build -w @sensa/contracts && npm run build -w @sensa/content-validator && npm run build -w @sensa/model-runtime && npm run build -w @sensa/mcp-server && npm run build -w @sensa/api && npm run build -w @sensa/web && npm run build -w @sensa/browser-extension",
    "build:cloudflare": "npm run build -w @sensa/learning-kernel && npm run build -w @sensa/contracts && npm run build -w @sensa/content-validator && npm run build -w @sensa/model-runtime && npm run build -w @sensa/mcp-server && npm run build -w @sensa/web",
    "build:api": "npm run build -w @sensa/learning-kernel && npm run build -w @sensa/contracts && npm run build -w @sensa/content-validator && npm run build -w @sensa/model-runtime && npm run build -w @sensa/api",
    "typecheck": "tsc -b --pretty false && tsc -p tests/web/tsconfig.json --pretty false && npm run typecheck -w @sensa/web && npm run typecheck -w @sensa/browser-extension",
    "test": "npm run test:fast",
    "test:web:foundation": "node --import tsx tests/web/run.mts",
    "test:web:db": "node --import tsx tests/web/run.mts --environment=browser-postgres",
    "test:fast": "node --import tsx tests/web/run.mts --suite=fast",
    "test:vitest": "node --import tsx tests/web/run.mts --suite=fast --runner=vitest",
    "test:coverage": "vitest run --config vitest.config.ts --coverage tests/web/unit/home-readiness.test.ts",
    "test:edge": "deno check --config supabase/functions/sensa-api/deno.json supabase/functions/sensa-api/index.ts",
    "test:browser": "node --import tsx tests/web/run.mts --suite=browser",
    "test:playwright": "node --import tsx tests/web/run.mts --suite=browser --runner=playwright",
    "benchmark:sqlite-opfs": "node --import tsx tests/web/run.mts --suite=browser --id=sqlite-opfs-benchmark",
    "benchmark:cloud-sync": "node --import tsx scripts/benchmarkCloudSyncScale.mts",
    "test:skin": "node --import tsx tests/web/run.mts --suite=browser --id=skin-surface",
    "test:db": "node --import tsx tests/web/run.mts --suite=database",
    "dev": "npm run dev -w @sensa/api",
    "start": "npm run start -w @sensa/api",
    "api:dev": "npm run dev -w @sensa/api",
    "api:start": "npm run start -w @sensa/api",
    "web:dev": "npm run dev -w @sensa/web",
    "web:build": "npm run build -w @sensa/web",
    "web:preview": "npm run preview -w @sensa/web",
    "dev:sensa": "node scripts/local/sensaLocal.mjs dev",
    "dev:sensa:models": "node scripts/local/sensaLocal.mjs dev --models",
    "preview:sensa": "node scripts/local/sensaLocal.mjs preview",
    "preview:sensa:models": "node scripts/local/sensaLocal.mjs preview --models",
    "reset:sensa": "node scripts/local/sensaLocal.mjs reset",
    "test:local-preview": "node scripts/local/sensaLocal.mjs dev --smoke",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "media:ingest": "node scripts/ingest-runtime-media.mjs",
    "content:compile": "python3 -m compileall -q content/pipeline content/tools",
    "content:help": "python3 content/tools/pipeline.py --help",
    "content:smoke": "python3 content/tools/smoke_pipeline.py",
    "content:smoke-concurrency": "python3 content/tools/smoke_pipeline_concurrency.py",
    "content:prepare-local": "node --import tsx scripts/local/prepareLearningBook.mts content/preview/lightweight-resources-v7.json .sensa-local/lightweight-resources-v7.json"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "2.115.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.1",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.20.0",
    "typescript": "^7.0.0",
    "vitest": "5.0.1",
    "wrangler": "4.131.1"
  }
}
