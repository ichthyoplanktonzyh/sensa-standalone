{
  "name": "learn-flow",
  "version": "1.0.0",
  "private": true,
  "description": "Sensa 语义学习 Runtime 交互原型",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.mjs",
    "dev:web": "vite --host localhost --port 5174 --strictPort",
    "dev:agent": "node --env-file-if-exists=.env server/semantic-agent-server.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sensa/contracts": "file:../../packages/contracts",
    "compromise": "^14.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^7.0.0",
    "vite": "^7.3.6"
  }
}
