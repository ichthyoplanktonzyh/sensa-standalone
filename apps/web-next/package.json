{
  "name": "learn-flow",
  "version": "1.0.0",
  "private": true,
  "description": "Sensa 语义学习 Runtime 交互原型",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.mjs",
    "dev:web": "vite --host localhost --port 5174 --strictPort",
    "dev:agent": "node --env-file-if-exists=.env server/semantic-agent-server.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke:router": "tsx src/router/shellLocationSmoke.ts",
    "smoke:stores": "tsx src/services/snapshotStoreSmoke.ts",
    "smoke": "npm run smoke:router && npm run smoke:stores && npm run smoke:styles",
    "smoke:styles": "tsx src/styles/stylesheetSmoke.ts"
  },
  "dependencies": {
    "@sensa/contracts": "file:../../packages/contracts",
    "@tanstack/react-router": "^1.170.32",
    "compromise": "^14.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.0",
    "vite": "^7.3.6"
  }
}
