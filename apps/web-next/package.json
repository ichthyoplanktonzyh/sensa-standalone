{
  "name": "learn-flow",
  "version": "1.0.0",
  "private": true,
  "description": "Sensa 语义学习 Runtime 交互原型",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.mjs",
    "dev:web": "vite --host localhost --port 5174 --strictPort",
    "dev:agent": "node --env-file-if-exists=.env server/semantic-agent-server.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke:router": "tsx src/router/shellLocationSmoke.ts",
    "smoke:stores": "tsx src/services/snapshotStoreSmoke.ts",
    "smoke:flow": "tsx src/learningFlow/flowSmoke.ts",
    "smoke:runtime": "tsx src/learningRuntime/runtimeSessionSmoke.ts",
    "smoke:journey": "tsx src/learningJourney/journeySmoke.ts",
    "smoke:meaning": "tsx src/personalMeaningJourney/journeySmoke.ts",
    "smoke:intake": "tsx src/personalMeaningJourney/intakeSmoke.ts",
    "smoke": "npm run smoke:router && npm run smoke:stores && npm run smoke:flow && npm run smoke:runtime && npm run smoke:surfaces && npm run smoke:intent && npm run smoke:orchestration && npm run smoke:renderers && npm run smoke:lightweight-initial && npm run smoke:agentic-provisioning && npm run smoke:capabilities && npm run smoke:provisioning && npm run smoke:retention && npm run smoke:scopes && npm run smoke:composition && npm run smoke:four-stage && npm run smoke:daily-plan && npm run smoke:journey && npm run smoke:meaning && npm run smoke:intake && npm run smoke:practice && npm run smoke:styles",
    "smoke:styles": "tsx src/styles/stylesheetSmoke.ts",
    "smoke:surfaces": "tsx src/learningRuntime/runtimeSurfacesSmoke.ts",
    "smoke:retention": "tsx src/learningRuntime/retentionStoresSmoke.ts",
    "smoke:capabilities": "tsx src/learningRuntime/contentCapabilitiesSmoke.ts",
    "smoke:provisioning": "tsx src/learningRuntime/contentProvisioningSmoke.ts",
    "smoke:intent": "tsx src/engine/stepIntentSmoke.ts",
    "smoke:orchestration": "tsx src/engine/stepOrchestrationSmoke.ts",
    "smoke:renderers": "tsx src/learningRuntime/stepRenderersSmoke.ts",
    "smoke:lightweight-initial": "tsx src/learningRuntime/lightweightInitialProtocolSmoke.ts",
    "smoke:agentic-provisioning": "tsx src/learningRuntime/contentAgentProvisioningSmoke.ts",
    "smoke:scopes": "tsx src/learningRuntime/retentionScopesSmoke.ts",
    "smoke:composition": "tsx src/learningRuntime/runtimeCompositionSmoke.ts",
    "smoke:daily-plan": "tsx src/planning/dailyInitialPlannerSmoke.ts",
    "smoke:four-stage": "tsx src/learningRuntime/interleavedFourStageProtocolSmoke.ts",
    "smoke:practice": "tsx src/practiceInventorySmoke.ts"
  },
  "dependencies": {
    "@sensa/contracts": "file:../../packages/contracts",
    "@sensa/learning-kernel": "file:../../packages/learning-kernel",
    "@tanstack/react-router": "^1.170.32",
    "compromise": "^14.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.0",
    "vite": "^7.3.6"
  }
}
