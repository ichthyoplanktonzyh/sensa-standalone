/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src http://127.0.0.1:* http://localhost:*; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), geolocation=()
  X-Robots-Tag: noindex

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/integrations/*
  Cache-Control: no-cache

/youglish-player.html
  Cache-Control: no-store
  ! X-Frame-Options
  Content-Security-Policy: default-src 'none'; script-src 'self' https://youglish.com https://www.youtube.com https://s.ytimg.com; style-src 'unsafe-inline'; img-src data: https://youglish.com https://*.ytimg.com; media-src blob: https://youglish.com https://*.googlevideo.com; connect-src https://youglish.com https://*.youglish.com https://www.youtube.com https://*.googlevideo.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors http://127.0.0.1:* http://localhost:*
  Cross-Origin-Resource-Policy: cross-origin
  Referrer-Policy: no-referrer

/assets/*
  Cache-Control: public, max-age=31536000, immutable
