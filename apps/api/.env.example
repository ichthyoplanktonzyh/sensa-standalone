# Local real-service acceptance. Copy to apps/api/.env; never commit populated values.
PORT=8080
ALLOWED_ORIGINS=http://127.0.0.1:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Restricted application role, separate from the migration administrator; require TLS remotely.
DATABASE_URL=
SENSA_REGISTRATION_POLICY=invited
SENSA_SEMANTIC_PROVIDER=deepseek
SENSA_SEMANTIC_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# 32 random bytes encoded as 64 hex characters. Generate outside source control.
SENSA_PROVIDER_VAULT_KEY=
# Set to 1 to pause the managed default model without deleting learning content.
SENSA_MANAGED_MODELS_PAUSED=0
# Production content publication sets an immutable public Registry URL. Inline
# JSON remains a local-preview and rollout fallback when no URL is configured.
# SENSA_PACKAGE_REGISTRY_URL=https://your-project.supabase.co/storage/v1/object/public/sensa-learning-content/registries/<revision>.json
# Paste the compact JSON from release-candidate/catalog.json for the fallback.
SENSA_PACKAGE_CATALOG_JSON={"items":[]}

# Opt-in personal testing only: disable rolling daily preparation/model quota.
SENSA_UNLIMITED_MODEL_USAGE=false

# Rolling daily pools, independently per billed purpose: reading and reference are
# per-interaction, teacher (clarification) and content are per-turn.
# SENSA_REFERENCE_DAILY_LIMIT=300   # reference defaults to 300; teacher/content are 30.

# Model per purpose when the managed Sensa connection answers.
SENSA_CONTENT_PROVIDER=deepseek
SENSA_CONTENT_MODEL=deepseek-flash
# SENSA_REVIEW_MODEL=              # defaults to SENSA_CONTENT_MODEL
# SENSA_REFERENCE_MODEL=           # defaults to SENSA_SEMANTIC_MODEL

# Extra accepted account-connection origins, comma separated. The built-in list is
# https://api.deepseek.com, https://api.openai.com and https://openrouter.ai.
# SENSA_READING_ALLOWED_ORIGINS=

# Per-process execution bounds, independent of daily usage quota.
SENSA_MODEL_CONCURRENCY=2
SENSA_MODEL_PROVIDER_CONCURRENCY=1
