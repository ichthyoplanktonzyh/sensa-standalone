{
  "name": "@sensa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=.env --import tsx/esm --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "@sensa/content-validator": "file:../../packages/content-validator",
    "@sensa/contracts": "file:../../packages/contracts",
    "@sensa/learning-kernel": "file:../../packages/learning-kernel",
    "@sensa/model-runtime": "file:../../packages/model-runtime",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "pg": "^8.13.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1"
  }
}
