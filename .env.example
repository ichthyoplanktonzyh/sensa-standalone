# Local API only. AUTH_MODE=none is accepted only on loopback with the
# explicit opt-in below; never use these values for a public deployment.
AUTH_MODE=none
ALLOW_INSECURE_LOCAL_AUTH=true
DATABASE_URL=postgresql://<app-user>:<password>@127.0.0.1:5432/sensa_standalone_dev
SENSA_LOCAL_LEARNER_ID=sensa-first-user
SENSA_LOCAL_WORKSPACE_ID=4e7f1d5b-47b9-4a9b-8f49-1b2aa18ed2a1
SENSA_MEDIA_ROOT=/absolute/path/to/sensa-standalone/runtime-media/audio
PORT=8080

# Standalone Sensa Web (Vite). These are browser build-time variables.
VITE_SENSA_API_URL=http://127.0.0.1:8080
VITE_WEB_PORT=3000
VITE_SENSA_REPLICA_ID=b6c1ae55-968a-4d8a-9e92-04a7e95fb9b2

# Owner URL is for local schema migration/content import only. Keep it out of
# committed files and shell history in any non-disposable environment.
# MIGRATION_DATABASE_URL=postgresql://<owner>:<password>@127.0.0.1:5432/sensa_standalone_dev
# SENSA_FIRST_USER_DATABASE_URL=postgresql://<owner>:<password>@127.0.0.1:5432/sensa_standalone_dev
