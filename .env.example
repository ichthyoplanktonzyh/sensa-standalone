# Local API only. AUTH_MODE=none is accepted only on loopback with the
# explicit opt-in below; never use these values for a public deployment.
AUTH_MODE=none
ALLOW_INSECURE_LOCAL_AUTH=true
DATABASE_URL=postgresql://<app-user>:<password>@127.0.0.1:5432/sensa_standalone_dev
DATABASE_POOL_MAX=10
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=3000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=10000
SENSA_LOCAL_LEARNER_ID=sensa-first-user
SENSA_LOCAL_WORKSPACE_ID=4e7f1d5b-47b9-4a9b-8f49-1b2aa18ed2a1
SENSA_MEDIA_ROOT=/absolute/path/to/sensa-standalone/runtime-media/audio
PORT=8080

# Standalone Sensa Web (Vite). These are browser build-time variables.
VITE_SENSA_API_URL=http://127.0.0.1:8080
VITE_SENSA_WEB_ORIGIN=http://127.0.0.1:3000
VITE_SENSA_YOUGLISH_ORIGIN=http://127.0.0.1:3001
VITE_SENSA_SUPPORT_URL=mailto:support@example.com
VITE_WEB_PORT=3000
VITE_SENSA_REPLICA_ID=b6c1ae55-968a-4d8a-9e92-04a7e95fb9b2

# Owner URL is for local schema migration/content import only. Keep it out of
# committed files and shell history in any non-disposable environment.
# MIGRATION_DATABASE_URL=postgresql://<owner>:<password>@127.0.0.1:5432/sensa_standalone_dev
# SENSA_FIRST_USER_DATABASE_URL=postgresql://<owner>:<password>@127.0.0.1:5432/sensa_standalone_dev

# Manual paid Content Agent live smoke only. Never expose this key through a
# VITE_* variable or commit a populated value.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Explicit UI mode. Preview retains the existing local behavior prototype.
# Production never falls back to preview or insecure local authentication.
VITE_SENSA_MODE=production
# Production auth: configure asymmetric JWT signing in Supabase, disable public
# signup, and provision invited subjects via a controlled server/CI workflow.
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only private audio adapter; supply through deployment secrets.
# SUPABASE_SERVICE_ROLE_KEY=
# SENSA_MEDIA_BUCKET=sensa-private-materials
