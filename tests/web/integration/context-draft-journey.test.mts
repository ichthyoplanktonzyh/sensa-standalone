/** Actual commands + SQLite/Wasm. No model, speech, or invented learning facts. */
import {afterAll,test,expect} from 'vitest';
import {useNodeLearningCapacityStorage} from '../../../scripts/support/nodeLearningCapacity.mts';
import {openLibrary,readLibrary,libraryTables} from '../../../apps/web/src/data/library/store';
import {createJourneyModules} from '../../../apps/web/src/experience/personalMeaningJourney/gateway';
import {LibraryJourneyRepository} from '../../../apps/web/src/experience/personalMeaningJourney/repository';
import {worldReadRepository} from '../../../apps/web/src/experience/personalMeaningJourney/worldRepository';
import {readMeaningContexts} from '../../../apps/web/src/experience/personalMeaningJourney/contextRecords';
import {validateBackupRows} from '../../../apps/web/src/data/library/backupValidation';
import {manualMeaningSense,newManualMeaningDraft} from '../../../apps/web/src/experience/intake/manualMeaning';
import {sensaIntakePayloadSchema} from '@sensa/contracts/sensa';
import {createSeededClock} from '../../../apps/web/src/experience/personalMeaningJourney/ports';
Object.assign(globalThis,{window:new EventTarget(),BroadcastChannel:undefined,location:new URL('http://context-journey.fixture.invalid')});
const database=await useNodeLearningCapacityStorage();afterAll(()=>database.close());await openLibrary();
const id=()=>crypto.randomUUID(),clock=createSeededClock('2026-10-11T16:00:00Z');
const gateway=()=>createJourneyModules({repository:new LibraryJourneyRepository(),clock}).personalMeaningJourney;
const rows=()=>readLibrary(async tx=>Object.fromEntries(await Promise.all(libraryTables.map(async table=>[table,await tx.entries(table)])))) as Promise<any>;
const record=(meaningId:string)=>readLibrary(tx=>readMeaningContexts(tx,meaningId));
const payload=async(meaningId:string,meaning:string,expression:string|null,reuse?:{senseId:string;senseVersionId:string})=>{
 const seed=await worldReadRepository.draftConfirmation(meaningId);
 return {source:seed.source,payload:sensaIntakePayloadSchema.parse({contractVersion:'sensa-intake-v3',operationId:id(),capturedAt:clock.nowIso(),context:seed.context,sense:manualMeaningSense({...newManualMeaningDraft(),meaning,...(reuse?{existingSense:{...reuse,senseKey:null,semanticSpec:manualMeaningSense({...newManualMeaningDraft(),meaning})!.semanticSpec}}:{})}),expression:expression?{surfaceForm:expression,languageTag:'en',expressionTypeHint:'word',occurrence:{surfaceForm:expression,locator:{kind:'personal_meaning',personalMeaningId:meaningId,personalSemanticAnchorRevisionIds:seed.contextRevisionIds}}}:null,acceptance:{mode:'learner_direct'}})};
};
test('one saved Context supports two drafts, Sense-only confirmation, later expression confirmation and pinned shared edits',async()=>{
 const g=gateway(),saved=await g.saveContext({operationId:id(),blocks:[{kind:'text',bodyText:'Maya borrowed my umbrella. I expect it back tomorrow.'}]});
 const first=await g.createMeaningDraft({operationId:id(),contextReferences:[saved],learnerIntentNote:'临时借用并归还。'}),second=await g.createMeaningDraft({operationId:id(),contextReferences:[saved],learnerIntentNote:'物品所有者暂借给别人。'});
 expect((await worldReadRepository.contextDetail(saved.contextId)).detail?.meaningCount).toBe(2);
 expect((await record(first.personalMeaningId))!.alignments).toEqual([]);
 const onlySense=await payload(first.personalMeaningId,'临时借用并归还。',null);
 const accepted=await g.confirmMeaningDraft({operationId:onlySense.payload.operationId,personalMeaningId:first.personalMeaningId,...onlySense});
 const senseRecord=(await record(first.personalMeaningId))!,alignment=senseRecord.alignments[0]!;
 expect(senseRecord.semanticAcceptances[0]).toMatchObject({personalExpressionAnchorRevisionId:null,expressionOccurrence:null});expect(senseRecord.bindingConfirmations).toEqual([]);
 expect((await worldReadRepository.detail(first.personalMeaningId)).detail?.directAlignments[0]?.confirmedBindings).toEqual([]);
 const seed=await worldReadRepository.correction(first.personalMeaningId,alignment.personalMeaningAlignmentId),operationId=id();
 await g.correctPersonalMeaning({operationId,personalMeaningId:first.personalMeaningId,personalMeaningAlignmentId:alignment.personalMeaningAlignmentId,source:seed.source,reuseSense:seed.reuseSense,payload:{...seed.payload,operationId,acceptance:{mode:'learner_direct'},expression:{surfaceForm:'borrow',languageTag:'en',expressionTypeHint:'word',occurrence:{surfaceForm:'borrow',locator:{kind:'personal_meaning',personalMeaningId:first.personalMeaningId,personalSemanticAnchorRevisionIds:seed.contextRevisionIds}}}}});
 const complete=(await record(first.personalMeaningId))!;
 expect(complete.alignments.at(-1)?.senseId).toBe(alignment.senseId);expect(complete.bindingConfirmations).toHaveLength(1);expect(complete.semanticAcceptances[0]).toEqual(senseRecord.semanticAcceptances[0]);
 const other=await payload(second.personalMeaningId,'物品所有者暂借给别人。','lend');await g.confirmMeaningDraft({operationId:other.payload.operationId,personalMeaningId:second.personalMeaningId,...other});
 const before=await rows();
 expect(await g.reviseSavedContext({operationId:id(),contextId:saved.contextId,expectedRevisionId:saved.revisionId,blocks:[{kind:'text',bodyText:'Maya borrowed my umbrella. I expect it back tomorrow.'}]})).toMatchObject(saved);
 expect(await rows()).toEqual(before);
 const next=await g.reviseSavedContext({operationId:id(),contextId:saved.contextId,expectedRevisionId:saved.revisionId,blocks:[{kind:'text',bodyText:'Maya returned my umbrella today.'}]});
 expect(next.contextId).toBe(saved.contextId);expect(next.revisionId).not.toBe(saved.revisionId);
 expect((await worldReadRepository.detail(first.personalMeaningId)).detail?.materialBlocks[0]?.bodyText).toBe('Maya borrowed my umbrella. I expect it back tomorrow.');
 expect((await worldReadRepository.detail(second.personalMeaningId)).detail?.materialBlocks[0]?.bodyText).toBe('Maya borrowed my umbrella. I expect it back tomorrow.');
 const third=await g.createMeaningDraft({operationId:id(),contextReferences:[next]});expect((await worldReadRepository.draftConfirmation(third.personalMeaningId)).context?.textSegment).toBe('Maya returned my umbrella today.');
 expect(accepted.personalMeaningId).toBe(first.personalMeaningId);
 for(const table of ['learningTargets','learningRuns','learningEvents','personalLearning'])expect((await rows())[table]).toEqual([]);
 validateBackupRows(await rows());
});
test('Context deletion is recoverable, preserves Meaning pins and refuses stale or forged lifecycle state',async()=>{
 const g=gateway(),saved=await g.saveContext({operationId:id(),blocks:[{kind:'text',bodyText:'A privately saved context.'}]}),draft=await g.createMeaningDraft({operationId:id(),contextReferences:[saved]});
 const deleted=await g.changeContextLifecycle({operationId:id(),contextId:saved.contextId,expectedRevisionId:saved.revisionId,action:'delete'});
 expect((await worldReadRepository.contextPage({query:'',status:'active',offset:0,limit:50})).items.some(row=>row.contextId===saved.contextId)).toBe(false);
 expect((await worldReadRepository.contextPage({query:'',status:'deleted',offset:0,limit:50})).items.some(row=>row.contextId===saved.contextId)).toBe(true);
 expect((await worldReadRepository.draftConfirmation(draft.personalMeaningId)).context?.textSegment).toBe('A privately saved context.');
 await expect(g.createMeaningDraft({operationId:id(),contextReferences:[deleted]})).rejects.toThrow('meaningChanged');
 const restored=await g.changeContextLifecycle({operationId:id(),contextId:saved.contextId,expectedRevisionId:deleted.revisionId,action:'restore'});
 await expect(g.reviseSavedContext({operationId:id(),contextId:saved.contextId,expectedRevisionId:saved.revisionId,blocks:[{kind:'text',bodyText:'stale overwrite'}]})).rejects.toThrow('meaningChanged');
 expect((await worldReadRepository.contextDetail(saved.contextId)).detail?.head).toMatchObject({status:'active',lifecycleRevision:3,currentRevisionId:restored.revisionId});
 const valid=await rows();validateBackupRows(valid);
 const forged=structuredClone(valid),head=forged.semanticContexts.find((row:any)=>row.key===`anchors:${saved.contextId}`);head.value.value.status='deleted';head.value.value.deletedAt=new Date().toISOString();head.value.value.deletedByOperationId=id();
 expect(()=>validateBackupRows(forged)).toThrow();
 const missingReceipt=structuredClone(valid);missingReceipt.semanticReceipts=missingReceipt.semanticReceipts.filter((row:any)=>row.value.command!=='ChangeContextLifecycle');expect(()=>validateBackupRows(missingReceipt)).toThrow();
});
