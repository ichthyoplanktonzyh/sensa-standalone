 await phase('batch-100-review-push',a);const bulkPull=await phase('batch-100-review-pull',b);assert(!bulkPull.network.some(r=>r.path.endsWith('/snapshot')));assert.deepEqual(await facts(a),await facts(b));await phase('no-change-after',a);report.finalValidation=await validate(a);report.peerValidation=await validate(b);report.finalFactRoot=createHash('sha256').update(JSON.stringify(Object.entries(await facts(a)).sort())).digest('hex');report.exactPeerFacts=true;
 report.completedAt=new Date().toISOString();await save();
