  const row={name,elapsedMs,requests:network.length,requestBodyBytes:network.reduce((n,r)=>n+r.requestBodyBytes,0),responseBodyBytes:network.reduce((n,r)=>n+r.responseBodyBytes,0),metadataUploaded,network,state:await page.evaluate(()=>(window as any).core.readCloudSync()),storage:await page.evaluate(()=>navigator.storage.estimate())};report.phases.push(row);await save();console.log(JSON.stringify({name,elapsedMs,requests:row.requests,requestBodyBytes:row.requestBodyBytes,responseBodyBytes:row.responseBodyBytes,metadataUploaded}));return row;
 };
