const url=process.env.SENSA_ADMIN_TEST_DATABASE_URL??process.env.SENSA_TEST_DATABASE_URL;
if(!url||new URL(url).hostname!=='127.0.0.1'||!new URL(url).pathname.startsWith('/sensa_m1a_'))throw Error('Disposable loopback database required');
const pool=new pg.Pool({connectionString:url,max:4}),keys=await generateKeyPair('ES256'),jwk=await exportJWK(keys.publicKey);jwk.kid='fixture';
const issuer='https://fixture.supabase.co/auth/v1',subject=crypto.randomUUID(),session=crypto.randomUUID(),installationId=crypto.randomUUID();
const now=Math.floor(Date.now()/1000);
const token=async(amr:unknown[]=[],sub=subject)=>new SignJWT({session_id:session,email:'fixture@example.invalid',amr}).setProtectedHeader({alg:'ES256',kid:'fixture'}).setIssuer(issuer).setSubject(sub).setAudience('authenticated').setIssuedAt().setExpirationTime('1h').sign(keys.privateKey);
let eraseCalls=0;
const app=createConsumerRoutes({telemetry:()=>{},verify:createConsumerVerifier(issuer,createLocalJWKSet({keys:[jwk]})),deleteIdentity:async(s,i)=>{assert.equal(s,subject);assert.equal(i,issuer);if(++eraseCalls===1)throw Error('synthetic provider failure');},transaction:async work=>{const db=await pool.connect();await db.query('BEGIN');try{await db.query('SET LOCAL ROLE backend_app');const result=await work(db);await db.query('COMMIT');return result;}catch(e){await db.query('ROLLBACK');throw e;}finally{db.release();}}});
const request=async(path:string,jwt:string,body?:unknown)=>{const r=await app.request(path,{method:body===undefined?'GET':'POST',headers:{authorization:'Bearer '+jwt,'content-type':'application/json'},body:body===undefined?undefined:JSON.stringify(body)});return {status:r.status,body:await r.json() as any};};
const saved=process.env.SENSA_REGISTRATION_POLICY;process.env.SENSA_REGISTRATION_POLICY='registered';
try{
 const original=await token(),fresh=await token([{method:'otp',timestamp:now}]);
 const access=await request('/sensa/web/access/session',original,{installationId});assert.equal(access.status,200);const accountId=access.body.accountId;
 const another=await token([],crypto.randomUUID());assert.equal((await request('/sensa/web/access/session',another,{installationId:crypto.randomUUID()})).status,200);
 const body={operationId:crypto.randomUUID(),confirmation:'delete-account'};
 assert.equal((await request('/sensa/account/deletion',original,body)).status,403);
 assert.equal((await request('/sensa/account/deletion',await token([{method:'otp',timestamp:now-3600}]),body)).status,403);
 assert.equal((await request('/sensa/account/deletion',await token([{method:'token_refresh',timestamp:now}]),body)).status,403);
 await pool.query('INSERT INTO sensa_consumer.intake_channels(account_id,library_id,config) VALUES($1,$2,$3)',[accountId,crypto.randomUUID(),JSON.stringify({fixture:true})]);
 await pool.query("INSERT INTO sensa_consumer.reading_settings(account_id,encrypted_settings) VALUES($1,'synthetic private settings')",[accountId]);
 const extensionToken='sensa_ext_'+crypto.randomUUID();
 const sessionRow=(await pool.query('SELECT id FROM sensa_consumer.sessions WHERE account_id=$1',[accountId])).rows[0];
 await pool.query('INSERT INTO sensa_consumer.extension_credentials(token_hash,account_id,session_id,scope_epoch,installation_id,expires_at) VALUES($1,$2,$3,1,$4,now()+interval \'1 day\')',[createHash('sha256').update(extensionToken).digest('hex'),accountId,sessionRow.id,installationId]);
 assert.equal((await request('/sensa/web/access/session',extensionToken,{installationId})).status,200);
 await pool.query("CREATE FUNCTION sensa_consumer.fixture_delete_failure() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'synthetic rollback'; END $$");
 await pool.query('CREATE TRIGGER fixture_delete_failure BEFORE DELETE ON sensa_consumer.reading_settings FOR EACH ROW EXECUTE FUNCTION sensa_consumer.fixture_delete_failure()');
 assert.equal((await request('/sensa/account/deletion',fresh,body)).status,503);
 assert.equal((await pool.query('SELECT lifecycle FROM sensa_consumer.accounts WHERE account_id=$1',[accountId])).rows[0].lifecycle,'active');
 assert.equal((await request('/sensa/web/access/session',extensionToken,{installationId})).status,200);
 await pool.query('DROP TRIGGER fixture_delete_failure ON sensa_consumer.reading_settings');await pool.query('DROP FUNCTION sensa_consumer.fixture_delete_failure()');
 const pending=await request('/sensa/account/deletion',fresh,body);
 assert.equal((await request('/sensa/web/access/session',extensionToken,{installationId})).status,401);
assert.equal(pending.status,200,JSON.stringify(pending.body));assert.equal(pending.body.state,'deletion_pending');
 assert.equal((await request('/sensa/web/access/session',fresh,{installationId})).status,403);
 assert.equal((await request('/sensa/service/status',original)).status,403);
 assert.equal((await pool.query('SELECT count(*)::int n FROM sensa_consumer.reading_settings WHERE account_id=$1',[accountId])).rows[0].n,0);
 assert.equal((await pool.query('SELECT count(*)::int n FROM sensa_consumer.intake_channels WHERE account_id=$1',[accountId])).rows[0].n,0);
 assert.equal((await pool.query('SELECT email FROM core.accounts WHERE account_id=$1',[accountId])).rows[0].email,null);
 assert.equal((await request('/sensa/account/deletion',fresh,{...body,operationId:crypto.randomUUID()})).status,409);
 const completed=await request('/sensa/account/deletion/status','invalid-expired-token',{operationId:body.operationId});assert.equal(completed.body.state,'deleted');
 assert.equal((await request('/sensa/account/deletion/status','',{operationId:crypto.randomUUID()})).status,404);assert.equal(eraseCalls,2);
 assert.equal((await request('/sensa/account/deletion',fresh,body)).body.state,'deleted');assert.equal(eraseCalls,2);
 assert.equal((await request('/sensa/web/access/session',await token([{method:'otp',timestamp:now}]),{installationId})).status,403);
 assert.equal((await request('/sensa/service/status',another)).status,200);
 console.log('PASS: fresh signed OTP proof, atomic erasure and permanent access barrier, provider failure/retry/idempotence, old/new session refusal and other-account isolation.');
}finally{if(saved===undefined)delete process.env.SENSA_REGISTRATION_POLICY;else process.env.SENSA_REGISTRATION_POLICY=saved;await pool.end();}
