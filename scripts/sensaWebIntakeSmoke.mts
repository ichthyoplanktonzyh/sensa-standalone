assert.equal((await message(finish,{...appSender,tab:{id:9}})).error,'authorization_expired');
assert.equal((await message({...finish,receipt:{redirectUri:'https://evil.invalid/?state='+pending.state}},appSender)).error,'authorization_invalid');
assert.equal((await message(finish,appSender)).value.connected,true);
assert.equal(exchangeCalls,1);assert.equal((storage.sensa as any).accounts[accountId].token,'fixture-renewed-token');
assert.equal((await message(finish,appSender)).error,'authorization_expired');
assert.equal((await message(connect,appSender)).value.connected,true);assert.equal(exchangeCalls,1);
