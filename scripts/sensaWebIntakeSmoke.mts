assert.equal(prepared.authorization.challenge,Buffer.from(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(pending.verifier))).toString('base64url'));
const redirectUri=prepared.authorization.redirectUri+'?state='+prepared.authorization.state+'&code=fixture-code';
