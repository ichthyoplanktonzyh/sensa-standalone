import assert from 'node:assert/strict';
import pg from 'pg';
import {createConsumerRoutes} from '../apps/api/src/sensa/access/consumer.ts';
import {createDelivery,encryptCapture,decryptCapture,createDeviceJoin,approveDevice,receiveDeviceGrant} from '../packages/intake-transport/src/index.ts';
const url=process.env.SENSA_TEST_DATABASE_URL;
if(!url||new URL(url).hostname!=='127.0.0.1'||!new URL(url).pathname.startsWith('/sensa_m1a_'))throw Error('Disposable loopback database required');
const pool=new pg.Pool({connectionString:url});let testNow=new Date();
const subjects=[crypto.randomUUID(),crypto.randomUUID()],sessions=[crypto.randomUUID(),crypto.randomUUID()];
process.env.SENSA_REGISTRATION_POLICY='registered';
const app=createConsumerRoutes({clock:()=>testNow,telemetry:()=>{},verify:async r=>{const index=r.headers.get('authorization')==='Bearer second'?1:0;return {issuer:'https://fixture.supabase.co/auth/v1',subject:subjects[index],sessionId:sessions[index],email:'fixture@sensa.invalid'};},transaction:async work=>{const db=await pool.connect();await db.query('BEGIN');try{await db.query('SET LOCAL ROLE backend_app');const value=await work(db);await db.query('COMMIT');return value;}catch(e){await db.query('ROLLBACK');throw e;}finally{db.release();}}});
const call=async(path:string,body?:unknown,token='first')=>{const response=await app.request('/sensa/'+path,{method:body===undefined?'GET':'POST',headers:{authorization:'Bearer '+token,'content-type':'application/json'},body:body===undefined?undefined:JSON.stringify(body)});return {status:response.status,value:await response.json() as any};};
try{
 const first=await call('web/access/session',{installationId:crypto.randomUUID()}),second=await call('web/access/session',{installationId:crypto.randomUUID()},'second');assert.equal(first.status,200);assert.equal(second.status,200);
 const accountId=first.value.accountId,libraryId=crypto.randomUUID(),prepared=await createDelivery(accountId,libraryId);
 const route='intake-delivery/';
 assert.equal((await call(route+'configure',prepared.config)).status,200);
 assert.equal((await call(route+'configure',prepared.config)).status,200);
 assert.equal((await call(route+'configure',prepared.config,'second')).status,403);
 assert.equal((await call(route+libraryId,undefined,'second')).status,404);
 const another=await createDelivery(accountId,libraryId);assert.equal((await call(route+'configure',another.config)).status,409);
 const capture={libraryId,clientId:crypto.randomUUID(),operationId:crypto.randomUUID(),text:'PRIVATE learning content'};
 const envelope=await encryptCapture(prepared.config,capture);
 assert.equal((await call(route+'push',envelope)).status,200);
 assert.equal((await call(route+'push',envelope)).status,200);
 assert.equal((await call(route+'push',await encryptCapture(prepared.config,capture))).status,409);
 assert.equal((await call(route+'push',envelope,'second')).status,403);
 const pending=await call(route+libraryId+'/pending');assert.equal(pending.value.items.length,1);
 assert.deepEqual(await decryptCapture(prepared.config,prepared.privateKey,pending.value.items[0]),capture);
 const stored=await pool.query('SELECT config,envelope FROM sensa_consumer.intake_channels JOIN sensa_consumer.intake_envelopes USING(account_id,library_id)');assert(!JSON.stringify(stored.rows).includes(capture.text));assert(!JSON.stringify(stored.rows).includes(prepared.privateKey.d));
 await call(route+'state',{libraryId,enabled:false});assert.equal((await call(route+libraryId+'/pending')).value.items.length,0);assert.equal((await call(route+'push',envelope)).status,409);await call(route+'state',{libraryId,enabled:true});
 const receipt={version:'sensa-intake-v1',libraryId,clientId:capture.clientId,operationId:capture.operationId,requestDigest:'a'.repeat(64),status:'pending',entityId:crypto.randomUUID(),committedAt:new Date().toISOString()};
 assert.equal((await call(route+'ack',{...receipt,clientId:crypto.randomUUID()})).status,409);
 assert.equal((await call(route+'ack',receipt)).status,200);assert.equal((await call(route+'ack',receipt)).status,200);
 assert.equal((await call(route+libraryId+'/pending')).value.items.length,0);
 assert.deepEqual((await call(route+'push',envelope)).value.receipt,receipt);
 assert.equal((await pool.query('SELECT envelope FROM sensa_consumer.intake_envelopes')).rows[0].envelope,null);
 const join=await createDeviceJoin(prepared.config);assert.equal((await call(route+'join',join.request)).status,200);
 assert.equal((await call(route+libraryId+'/devices')).value.items.length,1);
 const grant=await approveDevice(prepared.config,prepared.privateKey,join.request);assert.equal((await call(route+'approve',{libraryId,deviceId:join.request.deviceId,grant})).status,200);
 assert.deepEqual(await receiveDeviceGrant(prepared.config,join,(await call(route+libraryId+'/devices')).value.items[0].grant_envelope),prepared.privateKey);
 testNow=new Date(testNow.getTime()+11*60000);assert.equal((await call(route+libraryId+'/devices')).value.items.length,0);assert.equal((await call(route+'approve',{libraryId,deviceId:join.request.deviceId,grant})).status,409);
 await pool.query('DELETE FROM sensa_consumer.intake_channels WHERE account_id=$1',[accountId]);
 assert.equal((await pool.query('SELECT count(*)::int n FROM sensa_consumer.intake_envelopes')).rows[0].n,0);
 assert.equal((await pool.query('SELECT count(*)::int n FROM sensa_consumer.intake_device_requests')).rows[0].n,0);
 console.log('PASS: real Postgres migration and backend role, isolated accounts, ciphertext-only storage, replay/conflict, pause/resume, receipt and payload disposal, encrypted device grant and deletion cascade. No cloud or paid calls.');
}finally{await pool.end();}
