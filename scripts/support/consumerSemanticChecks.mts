import assert from 'node:assert/strict';
export const mockSemanticResolver=async(snapshot:any)=>({provider:'deterministic-fixture',model:'no-cost-v1',proposal:snapshot.expression?.text==='took'?{explanation:snapshot.expression.start>20?'在本句中，指坐到一个座位上。':'在本句中，指从容地花时间做事。',expression:{surface:'took',type:'word',language:'en'},semanticSpec:{schemaVersion:'sensa-sense-semantic-spec-v1',coreMeaningFocus:'以从容的速度做事',prototypeScenes:[{summary:'一个人有充足时间，按自己的节奏完成事情。',participantRoles:['行动者'],states:['时间充足'],directionOrCausality:null}],includedCases:['不急着完成'],excludedCases:['拿取物品'],neighborContrasts:[{label:'拿取',distinction:'这里说花费时间，不是移动物品。'}],openQuestions:[]}}:null});
export async function runSemanticChecks({request,initialize,bootstrap,push,token,pool,issuer,failLedger}:any){
 const subject=crypto.randomUUID();await pool.query('INSERT INTO sensa_consumer.invitations(issuer,subject) VALUES($1,$2)',[issuer,subject]);const bearer=await token(subject),installationId=crypto.randomUUID();await initialize(installationId,bearer);const boot=await bootstrap(installationId,bearer);
 const snapshot={sentence:'😀 She took her time, then took a seat.',language:'en',source:{url:'https://example.org/semantic',title:'Semantic fixture',capturedAt:new Date().toISOString()},expression:{text:'took',start:6,end:10}};
 const id=crypto.randomUUID(),lookup=await request('/sensa/semantic/lookups',{id,snapshot},bearer);assert.equal(lookup.status,200,JSON.stringify(lookup.body));assert.equal(lookup.body.status,'ready');
 assert.equal((await bootstrap(installationId,bearer)).meanings.length,0);assert.equal((await bootstrap(installationId,bearer)).intakes.length,0);
 assert.deepEqual((await request('/sensa/semantic/lookups',{id,snapshot},bearer)).body,lookup.body);
 assert.equal((await request('/sensa/semantic/lookups',{id,snapshot:{...snapshot,source:{...snapshot.source,title:'changed'}}},bearer)).status,409);
 const command=(kind:string,payload:any)=>({operationId:crypto.randomUUID(),occurredAt:new Date().toISOString(),installationId,replicaId:boot.replicaId,dependsOn:[],kind,payload});
 const inbox=(await push(boot,[command('intake.save',{snapshot})],bearer)).body.results[0].value.intake;
 const op=command('semantic.accept',{lookupId:id,expectedRevision:'1',intakeId:inbox.id,consent:'accept_context_expression_sense'});
 failLedger(true);assert.equal((await push(boot,[op],bearer)).status,503);failLedger(false);assert.equal((await bootstrap(installationId,bearer)).meanings.length,0);
 const result=(await push(boot,[op],bearer)).body.results[0];assert.equal(result.status,'accepted',JSON.stringify(result));assert.equal(result.value.plan,null);assert.equal(result.value.meaning.acceptanceKind,'direct');
 const after=await bootstrap(installationId,bearer);assert.equal(after.meanings.length,1);assert.equal(after.intakes[0].status,'confirmed');assert.equal(after.targets.length,0);assert.equal(after.runs.length,0);assert.equal(after.checkins.length,0);
 assert.equal((await push(boot,[op],bearer)).body.results[0].status,'replayed');assert.equal((await push(boot,[{...op,operationId:crypto.randomUUID()}],bearer)).body.results[0].value.meaning.id,result.value.meaning.id);
 const semantic=await pool.query('SELECT version_origin,semantic_review_status FROM sensa.sense_versions WHERE sense_version_id=$1',[result.value.meaning.senseVersionId]);assert.deepEqual(semantic.rows[0],{version_origin:'learner_confirmed',semantic_review_status:'learner_confirmed'});
 const secondId=crypto.randomUUID();await request('/sensa/semantic/lookups',{id:secondId,snapshot:{...snapshot,source:{...snapshot.source,url:'https://example.org/second'}}},bearer);
 const sameSense=(await push(boot,[command('semantic.accept',{lookupId:secondId,expectedRevision:'1',intakeId:null,consent:'accept_context_expression_sense'})],bearer)).body.results[0].value.meaning;assert.notEqual(sameSense.id,result.value.meaning.id);assert.equal(sameSense.senseId,result.value.meaning.senseId);assert.notEqual(sameSense.contextAnchorId,result.value.meaning.contextAnchorId);
 const unresolvedId=crypto.randomUUID();assert.equal((await request('/sensa/semantic/lookups',{id:unresolvedId,snapshot:{...snapshot,sentence:'unknown',expression:{text:'unknown',start:0,end:7}}},bearer)).body.status,'unresolved');assert.equal((await push(boot,[command('semantic.accept',{lookupId:unresolvedId,expectedRevision:'1',intakeId:null,consent:'accept_context_expression_sense'})],bearer)).body.results[0].error.code,'proposal_not_ready');
 const missing=await request('/sensa/semantic/lookups',{id:crypto.randomUUID(),snapshot:{...snapshot,expression:null}},bearer);assert.equal(missing.status,409);
 const otherSubject=crypto.randomUUID();await pool.query('INSERT INTO sensa_consumer.invitations(issuer,subject) VALUES($1,$2)',[issuer,otherSubject]);const other=await token(otherSubject),otherInstall=crypto.randomUUID();await initialize(otherInstall,other);const otherBoot=await bootstrap(otherInstall,other);assert.equal((await request('/sensa/semantic/lookups/'+id,undefined,other)).status,404);
 const foreign=await push(otherBoot,[{...op,operationId:crypto.randomUUID(),installationId:otherInstall,replicaId:otherBoot.replicaId}],other);assert.equal(foreign.body.results[0].error.code,'not_found');
 console.log('M2-B semantic passed: query creates no inventory, idempotent fixed proposal, atomic acceptance rollback/replay, learner-confirmed registry, Inbox transition, no curriculum/runtime/checkin, cross-account denial.');
}
