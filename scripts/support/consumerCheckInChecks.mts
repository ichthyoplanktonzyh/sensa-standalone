import assert from 'node:assert/strict';
export async function runCheckInChecks(h:any){
 const subject=crypto.randomUUID(),install=crypto.randomUUID(),clockId=crypto.randomUUID();await h.pool.query('INSERT INTO sensa_consumer.invitations(issuer,subject) VALUES($1,$2)',[h.issuer,subject]);
 const bearer=await h.token(subject);let init=await h.initialize(install,bearer,clockId);const learner=init.body.data.learnerUserId,boot=await h.bootstrap(install,bearer);
 const get=async(path:string)=>(await h.request(path,undefined,bearer));
 const command=(kind:string,payload:any,device=install,replica=boot.replicaId)=>({operationId:crypto.randomUUID(),occurredAt:h.now().toISOString(),installationId:device,replicaId:replica,dependsOn:[],kind,payload});
 const push=(ops:any,b=boot)=>h.push(b,Array.isArray(ops)?ops:[ops],bearer);
 const value=(r:any)=>{assert.equal(r.status,200,JSON.stringify(r));assert.equal(r.body.results[0].status,'accepted',JSON.stringify(r.body));return r.body.results[0].value;};
 const plan=value(await push(command('plan.confirm_quantity',{expectedRevision:null,dailyNewLimit:5,timeZone:'Asia/Shanghai'}))).plan;
 const record=(grant:any,runId:string|null=null,entry:string|null=null,device=install,replica=boot.replicaId)=>({...command('check_in.record',{source:runId?'formal_learning':'manual',runId,activityEntryOperationId:entry,timeZoneRevision:'1',clock:{grantId:grant.id,sessionId:grant.clockSessionId,elapsedMs:0}},device,replica),occurredAt:grant.issuedAt});
 const install2=crypto.randomUUID();const init2=await h.initialize(install2,bearer,crypto.randomUUID()),boot2=await h.bootstrap(install2,bearer);
 const manual=record(init.body.data.clockGrant),other=record(init2.body.data.clockGrant,null,null,install2,boot2.replicaId);
 const raced=await Promise.all([push(manual),push(other,boot2)]);assert.equal(value(raced[0]).checkin.id,value(raced[1]).checkin.id);assert.deepEqual(raced.map((r:any)=>value(r).alreadyRecorded).sort(),[false,true]);
 assert.equal((await push(manual)).body.results[0].status,'replayed');assert.equal((await get('/sensa/check-ins')).body.data.length,1);
 const foreign={...manual,operationId:crypto.randomUUID(),installationId:install2,replicaId:boot2.replicaId};assert.equal((await push(foreign,boot2)).body.results[0].error.code,'clock_untrusted');
 const candidate=(await get('/sensa/catalog/targets/b1000000-0000-4000-8000-000000000001')).body.data.candidate;
 value(await push(command('curriculum.add_target',{planId:plan.id,expectedScopeRevision:'1',candidateId:candidate.candidateId,source:candidate.source})));
 h.setNow(new Date(h.now().getTime()+86400000));
 const start=()=>command('activity.start_or_resume',{mode:'mixed',activityId:null,expectedScopeRevision:'2',clockSessionId:clockId});
 let entry=start(),runtime=value(await push(entry)).runtime;assert.equal((await get('/sensa/check-ins')).body.data.length,1,'creating a Run alone must not sign in');
 const bogus=record(runtime.run.offlineGrant,runtime.run.id,crypto.randomUUID());assert.equal((await push(bogus)).body.results[0].error.code,'invalid_checkin_source');
 let automatic=record(runtime.run.offlineGrant,runtime.run.id,entry.operationId);value(await push(automatic));assert.equal((await get('/sensa/check-ins')).body.data.length,2);
 h.setNow(new Date(h.now().getTime()+86400000));entry=start();runtime=value(await push(entry)).runtime;automatic=record(runtime.run.offlineGrant,runtime.run.id,entry.operationId);
 const reveal={...command('run.record_action',{runId:runtime.run.id,expectedRevision:runtime.run.revision,stepId:runtime.run.currentStep.id,ordinal:runtime.run.currentStep.ordinal,materialDigest:runtime.run.materialDigest,grantId:runtime.run.offlineGrant.id,clock:{sessionId:clockId,elapsedMs:0},action:{kind:'reveal'}}),occurredAt:runtime.run.offlineGrant.issuedAt};
 h.failCheckIn(true);const mixed=await push([automatic,reveal]);h.failCheckIn(false);assert.equal(mixed.status,200);assert.equal(mixed.body.results[0].status,'retryable');assert.equal(mixed.body.results[1].status,'accepted');assert.equal((await get('/sensa/runs/'+runtime.run.id)).body.data.currentStep.phase,'reveal');assert.equal((await get('/sensa/check-ins')).body.data.length,2);
 value(await push(automatic));assert.equal((await get('/sensa/check-ins')).body.data.length,3);
 h.setNow(new Date(h.now().getTime()+86400000));init=await h.initialize(install,bearer,clockId);const late=record(init.body.data.clockGrant);
 h.setNow(new Date(h.now().getTime()+2*86400000));const accepted=value(await push(late));assert.equal(accepted.checkin.occurredAt,late.occurredAt);assert.equal(accepted.checkin.date,new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Shanghai',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(late.occurredAt)));
 assert.notEqual(accepted.checkin.date,new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Shanghai',year:'numeric',month:'2-digit',day:'2-digit'}).format(h.now()));
 const badClock={...record(init.body.data.clockGrant),operationId:crypto.randomUUID()};badClock.payload.clock=null;assert.equal((await push(badClock)).body.results[0].error.code,'clock_untrusted');
 const wrongSession=record(init.body.data.clockGrant);wrongSession.payload.clock.sessionId=crypto.randomUUID();assert.equal((await push(wrongSession)).body.results[0].error.code,'clock_untrusted');
 const shifted=record(init.body.data.clockGrant);shifted.occurredAt=new Date(Date.parse(shifted.occurredAt)+60000).toISOString();assert.equal((await push(shifted)).body.results[0].error.code,'clock_untrusted');
 assert.equal((await push(record(init.body.data.clockGrant),{...boot,scopeEpoch:String(BigInt(boot.scopeEpoch)+1n)})).status,409);
 const changed={...late,payload:{...late.payload,clock:{...late.payload.clock,elapsedMs:1}}};assert.equal((await push(changed)).body.results[0].error.code,'operation_id_reuse');
 const foreignRead=await h.request('/sensa/check-ins');assert.ok(!foreignRead.body.data.some((x:any)=>x.id===accepted.checkin.id));
 await h.pool.query('UPDATE sensa_consumer.invitations SET revoked=true WHERE issuer=$1 AND subject=$2',[h.issuer,subject]);assert.equal((await push(record(init.body.data.clockGrant))).status,403);assert.equal((await get('/sensa/check-ins')).status,403);
 const facts=await h.pool.query('SELECT (SELECT count(*) FROM sensa_consumer.checkins WHERE learner_user_id=$1)::int AS days,(SELECT count(*) FROM sensa_consumer.memory_outcomes o JOIN sensa_consumer.runs r ON r.id=o.run_id WHERE r.learner_user_id=$1)::int AS outcomes',[learner]);assert.deepEqual(facts.rows[0],{days:4,outcomes:0});
 console.log('M1-E check-in passed: account-day race, manual/entry proof, no start-only claim, independent failure, late original date, clock/epoch/scope/revocation and no learning outcome.');
}
